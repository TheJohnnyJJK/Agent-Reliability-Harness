# Copy to .env and fill in. The offline pieces (dataset, tools, grading,
# taxonomy, metrics) need nothing here at all and are fully covered by
# `pytest -q`. You only need this file once you're ready to run a real
# framework agent against Claude.

# Required for any real agent run (LangGraph, CrewAI, or AG2) - all three
# frameworks are wired to call the same model through this one key, so the
# benchmark compares orchestration frameworks, not different models.
ANTHROPIC_API_KEY=

# Which Claude model all three frameworks call. Keep this the same across a
# single benchmark run - changing it mid-run makes the framework comparison
# meaningless, since you'd no longer be holding the model constant.
ANTHROPIC_MODEL=claude-sonnet-5

# Where the fixed synthetic dataset (customers, orders) lives. Defaults to
# ./harness.db. Read-only once seeded - no tool in this project ever writes
# to it, so there's nothing an agent can corrupt here.
AGENT_HARNESS_DB=./harness.db
